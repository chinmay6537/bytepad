{
  "name": "bytepad",
  "version": "1.0.0",
  "description": "Open-source online compiler that runs Python, C, C++, JavaScript and TypeScript in your browser with real interactive input, no signup and no ads.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "vendor": "node scripts/vendor-runtimes.mjs",
    "dev": "npm run vendor && vite",
    "build": "npm run vendor && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:cloud": "LIVE=1 vitest run tests/cloud-live.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@yowasp/clang": "22.0.0-git20542-10",
    "fflate": "0.8.3",
    "monaco-editor": "0.57.0",
    "pyodide": "314.0.7",
    "sucrase": "3.35.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "keywords": [
    "online-compiler",
    "online-ide",
    "webassembly",
    "pyodide",
    "clang",
    "wasi",
    "monaco-editor",
    "education",
    "open-source"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chinmay6537/bytepad.git"
  },
  "homepage": "https://chinmay6537.github.io/bytepad/",
  "author": "Chinmay S",
  "overrides": {
    "dompurify": "3.4.17"
  }
}
